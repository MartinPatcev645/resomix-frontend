# Base Urls for Navigation
# Marketing-site and beta-app origins. Links between landing, webapp, and admin are built from these.
# A wrong or empty landing origin turns those links into bare paths on the current app.
VITE_BASE_LANDING_URL=http://localhost:5173
VITE_BASE_BETA_URL=http://localhost:5174

# Server Urls for API Calls
# Backend is a bare origin with no path suffix. If it is unset, the client falls back to production.
# Media serves HLS, previews, and peaks.
VITE_SERVER_BACKEND=http://localhost:8001
VITE_SERVER_MEDIA=http://localhost:8002
