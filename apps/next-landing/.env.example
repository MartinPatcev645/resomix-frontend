# Public values only. Static export inlines NEXT_PUBLIC_* at build time.
NEXT_PUBLIC_BASE_BETA_URL=https://beta.resomix.com

# Canonical origin. Leave unset to keep https://resomix.com.
# A new Cloudflare hostname must not become the canonical until you choose that.
# NEXT_PUBLIC_SITE_ORIGIN=https://resomix.com

# Google Tag Manager container. Leave unset to keep GTM-PD9XQZRV.
# NEXT_PUBLIC_GTM_ID=GTM-PD9XQZRV

# Optional Organization sameAs profiles. Unset values are omitted.
# NEXT_PUBLIC_FACEBOOK_URL=
# NEXT_PUBLIC_INSTAGRAM_URL=
# NEXT_PUBLIC_TWITTER_URL=
# NEXT_PUBLIC_SOUNDCLOUD_URL=
