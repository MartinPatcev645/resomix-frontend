{
    "$schema": "https://html-validate.org/schemas/config.json",
    "extends": ["html-validate:recommended"],
    "rules": {
      "doctype-style": "error",
      "void-style": ["error", { "style": "omit" }],
      "no-dup-id": "error",
      "no-inline-style": ["error", { "allowedProperties": ["display", "visibility"] }],
      "wcag/h37": "error",
      "wcag/h67": "error"
  
    }
  }
  