{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "composite": true,
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "@resomix/ui": ["../../packages/ui/src/index.ts"],
      "@resomix/ui/*": ["../../packages/ui/src/*"],
      "@resomix/hooks": ["../../packages/hooks/src/index.ts"],
      "@resomix/hooks/*": ["../../packages/hooks/src/*"],
      "@resomix/api-client": ["../../packages/api-client/src/index.ts"],
      "@resomix/api-client/*": ["../../packages/api-client/src/*"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/ui" },
    { "path": "../../packages/hooks" },
    { "path": "../../packages/api-client" }
  ]
}
