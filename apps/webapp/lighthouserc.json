{
    "ci": {
      "collect": {
        "url": ["${BASE_URL:-http://localhost:5173}/"],
        "numberOfRuns": 3
      },
      "assert": {
        "preset": "lighthouse:recommended",
        "assertions": {
          "categories:performance": ["warn", { "minScore": 0.90 }],
          "categories:accessibility": ["error", { "minScore": 0.95 }],
          "categories:seo": ["warn", { "minScore": 0.90 }]
        }
      }
    }
  }
  