{
  "name": "landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/a11y.spec.ts",
    "lighthouse:mobile": "FORM_FACTOR=mobile lhci autorun",
    "lighthouse:desktop": "FORM_FACTOR=desktop lhci autorun",
    "lighthouse": "pnpm lighthouse:mobile && pnpm lighthouse:desktop",
    "validate:html": "html-validate \"dist/**/*.html\""
  },
  "dependencies": {
    "@resomix/api-client": "workspace:*",
    "@resomix/config": "workspace:*",
    "@resomix/hooks": "workspace:*",
    "@resomix/stores": "workspace:*",
    "@resomix/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.11",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^6.23.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.30.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "html-validate": "^10.1.2",
    "jsdom": "^27.0.0",
    "msw": "^2.11.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
