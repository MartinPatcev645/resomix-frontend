# Cloudflare Pages headers for the embed widget.
# The whole point of this project: allow it to be framed on ANY site.
# We do NOT set X-Frame-Options (Pages doesn't add it by default), and we explicitly permit
# framing via CSP frame-ancestors. To restrict WHO may embed, replace `*` with a space-separated
# allowlist, e.g.  Content-Security-Policy: frame-ancestors https://*.example.com https://foo.com
/*
  Content-Security-Policy: frame-ancestors *
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer-when-downgrade

# Long-cache the hashed build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted brand fonts. Filenames are NOT content-hashed, so if a face is ever replaced it must
# be renamed too — otherwise cached clients keep the old file for the full year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
