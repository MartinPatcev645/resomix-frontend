# Full rebuild of the electrobuzz Elasticsearch search index.
# Oneshot: started by es-reindex-tracks.timer (every ~15 days). Reads MariaDB and
# rebuilds the `tracks_search` alias with zero downtime. Idempotent + safe to re-run.
#
# Install (paths already match the Alwyzon box — adjust if yours differ):
#   sudo cp deploy/systemd/es-reindex-tracks.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now es-reindex-tracks.timer
#   sudo systemctl start es-reindex-tracks.service    # optional: run once now
#
[Unit]
Description=Resomix — rebuild electrobuzz Elasticsearch search index
After=network-online.target elasticsearch.service
Wants=network-online.target

[Service]
Type=oneshot
User=alwyzon
WorkingDirectory=/home/alwyzon/usman/basic_fastapi_server_resomix
EnvironmentFile=/home/alwyzon/usman/basic_fastapi_server_resomix/.env
ExecStart=/home/alwyzon/usman/basic_fastapi_server_resomix/.venv/bin/python -m scripts.es_reindex_tracks
# Keep the job from ever starving the box (ES itself does the heavy lifting).
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
