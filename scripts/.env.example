# Config for the Apple Music matching / catalog-selection scripts.
# Copy to scripts/.env and fill in real values. scripts/.env is gitignored.

# --- Resomix database (used only by the DB-backed selection + enrichment scripts) ---
RESOMIX_DB_HOST=localhost
RESOMIX_DB_PORT=3306
RESOMIX_DB_USER=your_db_user
RESOMIX_DB_PASSWORD=your_db_password
RESOMIX_DB_NAME=resomix_db

# --- Apple Music developer token (used by apple_music_test.py) ---
APPLE_TEAM_ID=your_team_id
APPLE_KEY_ID=your_key_id
APPLE_PRIVATE_KEY_PATH=./creds/AuthKey_XXXXXXXX.p8
APPLE_STOREFRONT=us
