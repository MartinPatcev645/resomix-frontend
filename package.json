{
  "name": "resomix-web",
  "version": "1.0.1",
  "workspaces": [
    "apps/*",
    "packages/*",
    "!apps/next-landing"
  ],
  "scripts": {
    "dev:landing": "pnpm --filter ./apps/landing dev",
    "dev:next-landing": "npm run dev --prefix apps/next-landing",
    "dev:webapp": "pnpm --filter ./apps/webapp dev",
    "dev:admin": "pnpm --filter ./apps/admin dev",
    "dev:embed": "pnpm --filter ./apps/embed dev",
    "build": "turbo run build",
    "cold:build": "turbo run build --cache=local:r,remote:r",
    "build:landing": "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=landing  --cache=local:r",
    "build:webapp": "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=webapp  --cache=local:r",
    "build:admin": "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=admin  --cache=local:r",
    "build:embed": "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=embed  --cache=local:r",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:e2e": "turbo run test:e2e",
    "lighthouse": "turbo run lighthouse",
    "validate:html": "turbo run validate:html"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.5",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.13.1",
  "private": "true",
  "dependencies": {
    "react": "^19.1.0"
  }
}
