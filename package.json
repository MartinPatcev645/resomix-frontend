{
  "name": "resomix-web",
  "version": "1.0.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "pnpm --filter ./apps/landing dev",
    "dev:webapp": "pnpm --filter ./apps/webapp dev",
    "build": "turbo run build",
    "cold:build": "turbo run build --cache=local:r,remote:r",
    "build:landing": "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=landing  --cache=local:r",
    "build:webapp":  "TURBO_DISABLE_DAEMON=1 pnpm turbo run build --filter=webapp  --cache=local:r"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.5",
    "typescript": "~5.8.3"
  },
  "packageManager": "pnpm@10.13.1",
  "private": "true",
  "dependencies": {
    "react": "^19.1.0"
  }
}
