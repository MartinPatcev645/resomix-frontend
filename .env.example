# ── Environment ─────────────────────────────────────────────────────
RESOMIX_ENV=development

# ── External Services ───────────────────────────────────────────────
SIMILARITY_SERVER_URL=http://localhost:8004
RESOMIX_SERVER_URL=http://localhost:8001
PUBLIC_ALWYZON_URL=http://localhost:8001
HLS_MEDIA_BASE_URL=http://localhost:8004
# Analysis microservice (resomix-analysis-service, on the Hetzner box). Leave UNSET to disable
# analysis (uploads still do similarity). ANALYSIS_INTERNAL_API_KEY must match the analysis
# service's RESOMIX_INTERNAL_API_KEY so only Alwyzon can trigger analyses.
ANALYSIS_SERVER_URL=http://localhost:8010
ANALYSIS_INTERNAL_API_KEY=generate_a_secure_cross_service_api_key

# ── Preview URL Security ────────────────────────────────────────────
PREVIEW_FERNET_SECRET=generate_a_secure_32_byte_fernet_secret_here
PREVIEW_HMAC_SECRET=generate_a_secure_hmac_secret_here
PREVIEW_AUDIO_URL_EXPIRES_SECONDS=300

# ── Partner API keys ────────────────────────────────────────────────
PARTNER_API_KEY_SIGNING_SECRET=generate_a_secure_partner_signing_secret_here
PARTNER_API_KEY_HASH_ALGORITHM=sha256

# ── Application ─────────────────────────────────────────────────────
# RESOMIX_API_KEY removed: the static frontend/admin super-key is retired. The frontend is
# anonymous or JWT-authenticated (→ System Partner 1) and admins use an admin-role JWT via
# /admin/auth/login. B2B partners authenticate with their own ``rmx_…`` keys.
RESOMIX_TEMP_DIR=temp_audio
RESOMIX_DEFAULT_TOP_SK=20
RESOMIX_APP_TITLE=Resomix API
RESOMIX_APP_DESCRIPTION=API for audio similarity search, track information, and metadata extraction
RESOMIX_APP_VERSION=3.0.1

# ── CORS ────────────────────────────────────────────────────────────
RESOMIX_USE_DEVELOPMENT_CORS=true
RESOMIX_ALLOWED_ORIGINS_DEVELOPMENT=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:8004"]
RESOMIX_ALLOWED_ORIGINS_PRODUCTION=["https://resomix.com","https://www.resomix.com","https://r-admin.resomix.com","https://beta.resomix.com","https://api-docs.resomix.com"]

# ── Modes ───────────────────────────────────────────────────────────
DEMO_MODE=false
SIMILARITY_AUTH_REQUIRED=false
# The platform's own "frontend" partner id (System Partner). Gates frontend-only
# behaviour (login-required similarity/playback) and is the default partner scope. Default: 1
SYSTEM_PARTNER_ID=1

# ── MariaDB ─────────────────────────────────────────────────────────
MARIA_DB_USER=root
MARIA_DB_PASS=test
MARIA_DB_HOST=127.0.0.1
MARIA_DB_PORT=3307
MARIA_DB_NAME=resomix_db

# ── Elasticsearch ───────────────────────────────────────────────────
ELASTICSEARCH_ENABLED=false

# ── Spotify OAuth ───────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Tidal OAuth ─────────────────────────────────────────────────────
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret

# ── Apple Music OAuth ───────────────────────────────────────────────
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=creds/AuthKey_G8UJ487ML5.p8
APPLE_PRIVATE_KEY_PEM=
APPLE_TOKEN_TTL=
APPLE_STOREFRONT=

# ── JWT & Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Password Policy ─────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ── Email Verification ──────────────────────────────────────────────
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=6
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ── 2FA ─────────────────────────────────────────────────────────────
TWO_FACTOR_CODE_EXPIRE_MINUTES=5
TWO_FACTOR_CODE_LENGTH=6

# ── Cookies ─────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT=1000/minute
REGISTER_RATE_LIMIT=1000/minute
PASSWORD_RESET_RATE_LIMIT=1000/minute

# ── Email Service (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.relay.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Resomix

ADMIN_NOTIFICATION_EMAIL=oppa@oppa.oppa

# ── Frontend ────────────────────────────────────────────────────────
FRONTEND_URL=https://example.com

# ── Cross-service secrets ───────────────────────────────────────────
HETZNER_INTERNAL_API_KEY=generate_a_secure_cross_service_api_key
REDIS_URL=redis://localhost:6379/0

# ── Telemetry ───────────────────────────────────────────────────────
TELEMETRY_FLUSH_INTERVAL_SECONDS=120
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_REDIS_KEY=telemetry:stream_events_queue
TELEMETRY_WORKER_POP_SIZE=1000

# ── Edge Authorization ──────────────────────────────────────────────
EDGE_JWT_SECRET=generate_a_secure_edge_jwt_secret_here
EDGE_TOKEN_TTL_SECONDS=14400

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── SFTP provisioning / partner-facing SFTP host ────────────────────
HETZNER_SFTP_PROVISION_URL=http://localhost:8004/internal/provision-sftp-user
SFTP_SERVER_HOST=sftp.example.com
SFTP_SERVER_PORT=2022
SFTP_BASE_PATH=/srv/sftp

# ── HLS media signing ───────────────────────────────────────────────
HLS_SIGNING_SECRET=generate_a_secure_hls_signing_secret_here
