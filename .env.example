# ── Environment ─────────────────────────────────────────────────────
RESOMIX_ENV=development

# ── External Services ───────────────────────────────────────────────
SIMILARITY_SERVER_URL=http://localhost:8004
RESOMIX_SERVER_URL=http://localhost:8001
PUBLIC_ALWYZON_URL=http://localhost:8001
HLS_MEDIA_BASE_URL=http://localhost:8004
# Analysis microservice (resomix-analysis-service, on the Hetzner box). Leave UNSET to disable
# analysis (uploads still do similarity). ANALYSIS_INTERNAL_API_KEY must match the analysis
# service's RESOMIX_INTERNAL_API_KEY so only Alwyzon can trigger analyses.
ANALYSIS_SERVER_URL=http://localhost:8010
ANALYSIS_INTERNAL_API_KEY=generate_a_secure_cross_service_api_key

# ── Preview URL Security ────────────────────────────────────────────
PREVIEW_FERNET_SECRET=generate_a_secure_32_byte_fernet_secret_here
PREVIEW_HMAC_SECRET=generate_a_secure_hmac_secret_here
PREVIEW_AUDIO_URL_EXPIRES_SECONDS=300

# ── Partner API keys ────────────────────────────────────────────────
PARTNER_API_KEY_SIGNING_SECRET=generate_a_secure_partner_signing_secret_here
PARTNER_API_KEY_HASH_ALGORITHM=sha256

# ── Application ─────────────────────────────────────────────────────
# RESOMIX_API_KEY removed: the static frontend/admin super-key is retired. The frontend is
# anonymous or JWT-authenticated (→ System Partner 1) and admins use an admin-role JWT via
# /admin/auth/login. B2B partners authenticate with their own ``rmx_…`` keys.
RESOMIX_TEMP_DIR=temp_audio
RESOMIX_DEFAULT_TOP_SK=20
RESOMIX_APP_TITLE=Resomix API
RESOMIX_APP_DESCRIPTION=API for audio similarity search, track information, and metadata extraction
RESOMIX_APP_VERSION=3.0.1

# ── CORS ────────────────────────────────────────────────────────────
RESOMIX_USE_DEVELOPMENT_CORS=true
RESOMIX_ALLOWED_ORIGINS_DEVELOPMENT=["http://localhost:5173","http://localhost:5174","http://localhost:5175","http://localhost:8004"]
RESOMIX_ALLOWED_ORIGINS_PRODUCTION=["https://resomix.com","https://www.resomix.com","https://r-admin.resomix.com","https://beta.resomix.com","https://api-docs.resomix.com"]

# ── Modes ───────────────────────────────────────────────────────────
DEMO_MODE=false
SIMILARITY_AUTH_REQUIRED=false
# The platform's own "frontend" partner id (System Partner). Gates frontend-only
# behaviour (login-required similarity/playback) and is the default partner scope. Default: 1
SYSTEM_PARTNER_ID=1

# ── MariaDB ─────────────────────────────────────────────────────────
MARIA_DB_USER=root
MARIA_DB_PASS=test
MARIA_DB_HOST=127.0.0.1
MARIA_DB_PORT=3307
MARIA_DB_NAME=resomix_db

# ── Elasticsearch ───────────────────────────────────────────────────
ELASTICSEARCH_ENABLED=false

# ── Spotify OAuth ───────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ── Tidal OAuth ─────────────────────────────────────────────────────
TIDAL_CLIENT_ID=your_tidal_client_id
TIDAL_CLIENT_SECRET=your_tidal_client_secret

# ── Apple Music OAuth ───────────────────────────────────────────────
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=creds/AuthKey_G8UJ487ML5.p8
APPLE_PRIVATE_KEY_PEM=
APPLE_TOKEN_TTL=
APPLE_STOREFRONT=

# ── JWT & Authentication ────────────────────────────────────────────
JWT_SECRET_KEY=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Password Policy ─────────────────────────────────────────────────
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=false

# ── Email Verification ──────────────────────────────────────────────
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=6
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# ── 2FA ─────────────────────────────────────────────────────────────
TWO_FACTOR_CODE_EXPIRE_MINUTES=5
TWO_FACTOR_CODE_LENGTH=6

# ── Cookies ─────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ── Rate Limiting ───────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
LOGIN_RATE_LIMIT=1000/minute
REGISTER_RATE_LIMIT=1000/minute
PASSWORD_RESET_RATE_LIMIT=1000/minute

# ── Email Service (SMTP) ────────────────────────────────────────────
SMTP_HOST=smtp.relay.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Resomix

ADMIN_NOTIFICATION_EMAIL=oppa@oppa.oppa

# ── Frontend ────────────────────────────────────────────────────────
FRONTEND_URL=https://example.com
FRONTEND_BETA_URL=https://beta.example.com
ADMIN_URL=https://admin.example.com

# ── Cross-service secrets ───────────────────────────────────────────
HETZNER_INTERNAL_API_KEY=generate_a_secure_cross_service_api_key
REDIS_URL=redis://localhost:6379/0

# ── Telemetry ───────────────────────────────────────────────────────
TELEMETRY_FLUSH_INTERVAL_SECONDS=120
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_REDIS_KEY=telemetry:stream_events_queue
TELEMETRY_WORKER_POP_SIZE=1000

# ── Edge Authorization ──────────────────────────────────────────────
EDGE_JWT_SECRET=generate_a_secure_edge_jwt_secret_here
EDGE_TOKEN_TTL_SECONDS=14400

# ── Stripe ──────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# Consumer subscription billing (docs/CONSUMER_BILLING_PLAN.md). Consumer price IDs live in the
# plan_prices table; these env vars only bootstrap the seed.
STRIPE_PRICE_PRO_MONTHLY_EUR=price_your_pro_monthly_eur_price_id
STRIPE_BILLING_PORTAL_CONFIG_ID=bpc_your_customer_portal_config_id
STRIPE_AUTOMATIC_TAX_ENABLED=false

# ── PostHog (server-side capture) ───────────────────────────────────
# Only for events no browser can report, currently the Stripe-confirmed subscription_started.
# The site's own PostHog is loaded by the GTM container, not from here. Leave the key empty to
# disable capture entirely, which is the right setting for local development.
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# Label for the `environment` property. Leave unset in production. Staging sets `staging`, and
# must NOT change RESOMIX_ENV to get it (that flips the guest cookie's secure flag).
POSTHOG_ENVIRONMENT=

# ── SFTP provisioning / partner-facing SFTP host ────────────────────
HETZNER_SFTP_PROVISION_URL=http://localhost:8004/internal/provision-sftp-user
SFTP_SERVER_HOST=sftp.example.com
SFTP_SERVER_PORT=2022
SFTP_BASE_PATH=/srv/sftp

# ── HLS media signing ───────────────────────────────────────────────
HLS_SIGNING_SECRET=generate_a_secure_hls_signing_secret_here

# ── Google Auth ───────────────────────────────────────────────
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── Elastic Search ───────────────────────────────────────────────
ES_URL=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=<your elastic password>
ES_VERIFY_CERTS=true
ES_CA_CERTS=/etc/elasticsearch/certs/http_ca.crt
ES_INDEX_ALIAS=tracks_search
ELASTICSEARCH_ENABLED=false
ES_WRITE_USERNAME=resomix_index
ES_WRITE_PASSWORD=9db7fd591b386c53e2e97ojr4w97ad05cee
ES_SEARCH_LIMIT=20

# ── Cloudflare Access (Zero Trust) — admin edge gate ───────────────────────────────
# When CF_ACCESS_ENABLED=true, admin routes also require a valid Cloudflare Access JWT
# (Cf-Access-Jwt-Assertion). Leave false until the admin API is reached THROUGH the
# Access-protected origin, or every admin call will 403. Team domain + AUD tag come from
# the Zero Trust dashboard (Settings → team name; Access → Applications → AUD tag).
CF_ACCESS_ENABLED=false
CF_ACCESS_TEAM_DOMAIN=veggera.cloudflareaccess.com
CF_ACCESS_AUD=your_access_application_aud_tag_here

# ---------------------------------------------------------------------------
# Data retention (GDPR)
#
# All four have working defaults — set them only to deviate. See
# docs/ACCOUNT_DELETION_GDPR_OPTIONS.md §4.5 for the reasoning and the legal ceilings.
# ---------------------------------------------------------------------------

# How long `system_logs` rows are kept. Enforced by scripts/prune_system_logs.py (daily systemd
# timer — see RUNBOOK.md). 90 days is standard for security logs held on legitimate-interest
# grounds; 12 months is the ceiling most supervisory authorities accept unargued. `0` disables
# pruning entirely (refused, never read as "delete everything").
SYSTEM_LOG_RETENTION_DAYS=90

# Same, for ip_address/user_agent on expired sessions.
SESSION_IP_RETENTION_DAYS=90

# How long invoices and financial records are kept. NOT our choice — tax and accounting law, which
# varies by member state (5-10 years across the EU). Confirmed with the accountant: 7.
INVOICE_RETENTION_YEARS=7

# Days within which an admin should have actioned a deletion request. Art. 12(3) allows one month.
# This is NOT a timer — nothing scrubs automatically. It ages the admin queue at
# GET /admin/users/pending-deletions (amber at two-thirds, red past it).
DELETION_REQUEST_SLA_DAYS=30
