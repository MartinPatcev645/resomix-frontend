# ResomiX API Environment Configuration
# =====================================

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# External Services
SIMILARITY_SERVER_URL=http://localhost:5000
RESOMIX_SERVER_URL=http://localhost:8000

# Google Sheets Integration
SERVICE_ACCOUNT_FILE=creds/service-account-key.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
FEEDBACK_WORKSHEET_NAME=Feedback
CONTACT_WORKSHEET_NAME=ContactSubmissions

# Preview URL Security (IMPORTANT: Use strong, unique secrets in production)
# Fernet secret must be exactly 32 bytes when base64 decoded
PREVIEW_FERNET_SECRET=m3mUndffWiUXh-E3vIWTSJ8AeCdhfzNdDjOWplmuQNM=
PREVIEW_HMAC_SECRET=jxkXbUNa0uGRPnaO7zICZxDPw7PpcI0C-JXx8V39FSU

# Preview URL expiration time in seconds (300 = 5 minutes)
PREVIEW_AUDIO_URL_EXPIRES_SECONDS=300

# Legacy RESOMIX_ prefixed variables (optional - for backward compatibility)
RESOMIX_API_KEY=bearer-resomix-api-V2BjX95N3MwxtCNQ83jWQmkqTtwJzJ
RESOMIX_TEMP_DIR=temp_audio
RESOMIX_DEFAULT_TOP_SK=20
RESOMIX_APP_TITLE=Resomix API
RESOMIX_APP_DESCRIPTION=API for audio similarity search, track information, and metadata extraction
RESOMIX_APP_VERSION=1.0.1

# CORS
RESOMIX_USE_DEVELOPMENT_CORS=true   # Set false in production
# RESOMIX_ALLOWED_ORIGINS_DEVELOPMENT=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5175
# RESOMIX_ALLOWED_ORIGINS_PRODUCTION=https://resomix.com,https://beta.resomix.com,https://www.resomix.com,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5175


# MariaDB Configuration (if used)
MARIA_DB_USER=your_db_user
MARIA_DB_PASS=your_db_password
MARIA_DB_HOST=127.0.0.1
MARIA_DB_PORT=3307
MARIA_DB_NAME=your_database_name

# ElasticSearch Configuration
ES_URL=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=your_elasticsearch_password
ES_VERIFY_CERTS=False   # Set false if ca certs not available
ES_CA_CERTS=path_to_logstash_http_ca.crt
ES_REQUEST_TIMEOUT=20
ES_SEARCH_LIMIT=100
ELASTICSEARCH_ENABLED=true

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Tidal OAuth
TIDAL_CLIENT_ID=your_client_id
TIDAL_CLIENT_SECRET=your_client_secret
