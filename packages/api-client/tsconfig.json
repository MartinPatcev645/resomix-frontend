{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationDir": "dist/src",
    "emitDeclarationOnly": false,
    "outDir": "dist/src",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@resomix/config": ["../config/dist"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../config" }
  ]
}
