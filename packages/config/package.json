{
  "name": "@resomix/config",
  "version": "0.0.0",
  "description": "Shared runtime configuration loaded from Vite env vars.",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
