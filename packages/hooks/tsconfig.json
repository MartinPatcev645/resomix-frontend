{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@resomix/api-client": ["../api-client/src", "../api-client/dist/src"],
      "@resomix/ui": ["../ui/src", "../ui/dist"],
      "@resomix/stores": ["../stores/src", "../stores/dist"],
      "@resomix/config": ["../config/src", "../config/dist"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../api-client" },
    { "path": "../stores" },
    { "path": "../ui" },
    { "path": "../config" }
  ]
}
