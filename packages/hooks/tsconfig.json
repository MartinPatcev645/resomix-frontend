{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "paths": {
      "@resomix/api-client": ["../api-client/src", "../api-client/dist/src"],
      "@resomix/ui": ["../ui/dist"],
      "@resomix/stores": ["../stores/dist"]
    }
  },
  "include": ["src"]
}
