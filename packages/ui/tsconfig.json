{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": false,
    "outDir": "dist",
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@resomix/config": ["../config/src", "../config/dist"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../config" },
    { "path": "../stores" }
  ]
}
